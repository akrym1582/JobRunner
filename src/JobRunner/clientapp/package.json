{
  "name": "jobrunner-clientapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "generate-api": "node scripts/generate-api.mjs",
    "export-api": "dotnet run --project .. --no-launch-profile -- --export-openapi",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "benchmark:format": "node scripts/benchmark-format.mjs",
    "benchmark:editor": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@aspida/fetch": "^1.14.0",
    "@aspida/swr": "^1.14.0",
    "@tailwindcss/vite": "^4.1.0",
    "aspida": "^1.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@azure/storage-blob": "12.26.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "azurite": "3.35.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "openapi2aspida": "^0.24.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
